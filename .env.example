# Chave da API da Anthropic. Copie este arquivo para .env (mesma pasta) e
# preencha com sua chave real. O .env NUNCA deve ser commitado.
#
# Toda variavel exposta ao front-end pelo Vite precisa do prefixo VITE_,
# caso contrario import.meta.env.VITE_ANTHROPIC_API_KEY sera undefined.
VITE_ANTHROPIC_API_KEY=sua_chave_aqui
