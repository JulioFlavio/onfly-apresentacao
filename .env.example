# Chave da API da Anthropic. Copie este arquivo para .env (mesma pasta) e
# preencha com sua chave real. O .env NUNCA deve ser commitado.
#
# NAO use o prefixo VITE_: variaveis com esse prefixo sao injetadas no
# bundle do frontend pelo Vite e ficam visiveis no DevTools do browser.
# A chave e lida apenas pelo proxy do Vite (dev) e pela Edge Function (prod).
ANTHROPIC_API_KEY=sua_chave_aqui
